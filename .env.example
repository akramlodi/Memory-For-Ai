# ---------------------------------------------------------------
# Elephantus configuration. Copy to `.env` and fill in ONE provider.
# ---------------------------------------------------------------

# Which LLM to use: anthropic | openai | ollama | azure
LLM_PROVIDER=anthropic

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=
# Ollama (local, keyless). Install from https://ollama.com and `ollama pull <model>`
OLLAMA_BASE_URL=http://localhost:11434

# Azure AI Foundry. The project endpoint from the Foundry portal works as-is, e.g.
#   https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_ENDPOINT=
AZURE_API_KEY=
# Instead of a key, sign in with your Azure identity (az login / managed identity).
# Requires: pip install -e ".[azure]"
AZURE_USE_ENTRA_ID=false

# Model name. Leave empty for the provider default:
#   anthropic -> claude-opus-5-5, openai -> gpt-4o-mini, ollama -> qwen2.5:7b,
#   azure -> gpt-4o (for Azure this is your DEPLOYMENT name)
LLM_MODEL=

# Embeddings: "fastembed" (local ONNX model, downloaded automatically on first use)
# or "hash" (no download, lower quality; useful offline / in tests)
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Storage (relative paths are resolved from the project root)
DATABASE_PATH=data/memory.db

# Server (web UI at http://API_HOST:API_PORT/, API docs at /docs)
API_HOST=127.0.0.1
API_PORT=8000

# Container tag used by the MCP server when the client does not pass one
DEFAULT_CONTAINER_TAG=default

LOG_LEVEL=INFO
